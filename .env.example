# LLM Configuration
LLM_PROVIDER=anthropic              # anthropic, openai, ollama
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Model Selection
ANTHROPIC_MODEL=claude-haiku-4-5   # https://platform.claude.com/docs/en/about-claude/models/overview
OPENAI_MODEL=gpt-4o                # https://platform.openai.com/docs/pricing

# Workspace
WORKSPACE_PATH=./workspace

# Timeouts (seconds)
ACTIVITY_TIMEOUT=300                # 5 minutes
OVERALL_TIMEOUT=3600                # 60 minutes

# Database
DATABASE_PATH=./workspace/agent.db

# Streamlit
STREAMLIT_SERVER_PORT=8501
